# Zkopíruj jako .env.local a doplň hodnoty ze Supabase:
# Project Settings → API Keys (nebo tlačítko „Connect“ nahoře v projektu).
# Obě hodnoty jsou veřejné — co kdo smí, hlídá databáze (Row Level Security).
# Tajný service_role / secret klíč sem NEPATŘÍ, web ho nepotřebuje.

NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxx

# Adresa webu pro odkazy v e-mailech (potvrzení účtu, nové heslo).
# Lokálně nech zakomentované — vezme se adresa, ze které formulář přišel.
# NEXT_PUBLIC_SITE_URL=https://clutchleague.cz

# E-maily kapitánům o rozhodnutí organizátora (schválená / zamítnutá přihláška).
# Bez nich se kapitán dozví jen v portálu (oznámení). Klíč z resend.com (Sending access)
# je TAJNÝ — patří jen do Vercelu (Environment Variables), nikdy do repozitáře.
# RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
# MAIL_FROM=Clutch League <noreply@clutchleague.cz>
